[ext_resource type="Script" uid="uid://cxbfgfn57t2wx" path="res://scripts/game/story_data/story.gd" id="1_story"]
[ext_resource type="Script" uid="uid://cpqpuectutiv0" path="res://scripts/game/story_data/story_loop.gd" id="2_loop"]
[ext_resource type="Script" uid="uid://erhlgkdvc6lh" path="res://scripts/game/story_data/story_stage.gd" id="3_stage"]

[sub_resource type="Resource" id="LoopOne_denial"]
script = ExtResource("3_stage")
maze_memories = Array[String](["I told everyone children are resilient because the alternative had teeth.", "Your shoes still lit up when I stepped on them by accident.", "The dinosaur cup stayed by the sink, waiting for apple juice.", "You asked if the hospital had a playground, and I said probably.", "I folded your pajamas for next week."])
closing_memory = "I found one of your drawings folded in the pocket of my coat. A sun, a house, three people with stick arms. I remembered you giving it to me in the waiting room, and I remembered saying, \"I'll look properly when we get home.\""

[sub_resource type="Resource" id="LoopOne_anger"]
script = ExtResource("3_stage")
grief_stage = 1
maze_memories = Array[String](["I hated the nurses for knowing which drawer held the tiny blood pressure cuff.", "I hated every healthy child screaming in the grocery store.", "I hated God most on the days you thanked him for pudding.", "The doctor said aggressive, and I wanted to teach the word fear.", "I hated my hands for being warm when yours were not."])
closing_memory = "I smiled at you while the doctor spoke because your eyes kept asking me what kind of room we were in. Afterward, in the hallway, I pressed my forehead to the vending machine and hated it for giving people exactly what they paid for."

[sub_resource type="Resource" id="LoopOne_bargaining"]
script = ExtResource("3_stage")
grief_stage = 2
maze_memories = Array[String](["I learned the exact angle of the pillow that made breathing sound less like work.", "If I counted the pills correctly, the morning would forgive us.", "I traded sleep for five more minutes of your eyes open.", "I promised the ceiling I would never complain again if you could keep breakfast down.", "I kept bargaining with thermometers, spoons, blankets, hands."])
closing_memory = "I used to whisper trades into your hair while you slept. My years for yours. My breath for yours. Anything. Everything. In the morning, you would wake thirsty, and I would think the world had considered my offer."

[sub_resource type="Resource" id="LoopOne_depression"]
script = ExtResource("3_stage")
grief_stage = 3
maze_memories = Array[String](["The cartoons kept playing after you fell asleep.", "Your laugh got smaller before it disappeared.", "I learned there is a silence heavier than crying.", "The hospital chair knew my spine better than my own bed did.", "I started missing you while you were still breathing."])
closing_memory = "One afternoon you slept through the nurse, the medicine, the woman mopping around the bed. I watched a square of sun move across the floor and understood I could not make even light stay where I needed it."

[sub_resource type="Resource" id="LoopOne_acceptance"]
script = ExtResource("3_stage")
grief_stage = 4
maze_memories = Array[String](["I stopped asking you to be brave.", "I climbed into the bed when the nurse moved the wires.", "Your hand relaxed before mine did.", "I told you it was okay to go, and hated myself for telling the truth.", "The room did not become peaceful. It became honest."])
closing_memory = "When your breathing changed, I stopped counting. I put my mouth near your ear and told you about the house, the cup, the shoes that still lit up. I wanted the last place you heard about to be home."

[sub_resource type="Resource" id="LoopOne"]
script = ExtResource("2_loop")
title = "The House That Still Expected Morning"
stages = Array[ExtResource("3_stage")]([SubResource("LoopOne_denial"), SubResource("LoopOne_anger"), SubResource("LoopOne_bargaining"), SubResource("LoopOne_depression"), SubResource("LoopOne_acceptance")])

[sub_resource type="Resource" id="LoopTwo_denial"]
script = ExtResource("3_stage")
maze_memories = Array[String](["I kept the nightlight on because darkness had not earned your room yet.", "Your toothbrush stayed in the cup, stiff with a final morning.", "I washed everything except the blanket.", "I woke at two to check your temperature and found the air instead.", "I bought apple juice before remembering who drank it."])
closing_memory = "For weeks, I left your door open the exact width of a sleeping child's breath. Not open. Not closed. Just enough for a mother to pretend she was being practical."

[sub_resource type="Resource" id="LoopTwo_anger"]
script = ExtResource("3_stage")
grief_stage = 1
maze_memories = Array[String](["The funeral home had a catalog for small urns.", "I hated the woman who said at least she is not suffering and kept breathing afterward.", "I hated your father for crying differently than I did.", "I hated the sun for landing on your photograph like nothing had happened.", "People brought casseroles, as if grief had teeth and could be fed."])
closing_memory = "After the funeral, I broke a plate because it was the only thing in the kitchen that would admit it was breakable. Then I stood barefoot in the pieces, waiting to feel sorry. I only felt smaller."

[sub_resource type="Resource" id="LoopTwo_bargaining"]
script = ExtResource("3_stage")
grief_stage = 2
maze_memories = Array[String](["I offered every birthday I had left for one more feverish afternoon.", "I replayed the first bruise, the first cough, the first time I should have known.", "If I had asked for another test, another doctor, another miracle with paperwork.", "I made deals with photographs until their smiles became cruel.", "I promised I would forgive anything if the crib creaked once."])
closing_memory = "I wrote down the dates as if the right sequence could accuse the universe into returning you. First fever. First scan. First night I lied when you asked if you were better. The paper filled up. Nothing answered."

[sub_resource type="Resource" id="LoopTwo_depression"]
script = ExtResource("3_stage")
grief_stage = 3
maze_memories = Array[String](["Her room became the loudest place in the house.", "Dust gathered on toys with no idea it was trespassing.", "I stopped correcting people when they asked how many children I had.", "The calendar kept producing days she would not use.", "My body kept waking up as if mother were still a job with hours."])
closing_memory = "There was a day I did nothing but sit beside your closed door. No crying. No praying. No memory sharp enough to cut me. Just the door, the carpet, the shape of my knees, and the terrible work of remaining."

[sub_resource type="Resource" id="LoopTwo_acceptance"]
script = ExtResource("3_stage")
grief_stage = 4
maze_memories = Array[String](["I packed one drawer and left the rest.", "I said her name at breakfast and did not apologize to the table.", "I gave away the unopened medicine and kept the dinosaur cup.", "I learned that gone is not the same as never.", "I became her mother in the past tense and the present tense at once."])
closing_memory = "I said your name out loud while washing a cup. Nothing answered. Nothing opened. But the name stayed warm in my mouth, and for the first time I did not use it to call you back. I used it because you had been here."

[sub_resource type="Resource" id="LoopTwo"]
script = ExtResource("2_loop")
title = "The House After Small Hands"
stages = Array[ExtResource("3_stage")]([SubResource("LoopTwo_denial"), SubResource("LoopTwo_anger"), SubResource("LoopTwo_bargaining"), SubResource("LoopTwo_depression"), SubResource("LoopTwo_acceptance")])

[sub_resource type="Resource" id="LoopThree_denial"]
script = ExtResource("3_stage")
maze_memories = Array[String](["Years later, I heard a girl laugh in a pharmacy and turned before I could stop myself.", "I told myself grief had become manageable because I had learned its schedule.", "I kept her age wrong in my head because seven was where I could still hold her.", "The anniversary arrived quietly, and I mistook that for mercy.", "I thought healing meant the memories would stop ambushing me."])
closing_memory = "I saw a school uniform in a shop window and thought, for one clean second, that I should buy the larger size. My hand was already on the glass before the years came back."

[sub_resource type="Resource" id="LoopThree_anger"]
script = ExtResource("3_stage")
grief_stage = 1
maze_memories = Array[String](["I hated time for taking things death had missed.", "I hated that I could not remember which front tooth came in crooked.", "I hated new mothers for complaining in parks.", "I hated myself when a whole afternoon passed without her.", "I hated that survival had made me practiced."])
closing_memory = "I found myself laughing at a joke before I remembered to be ashamed. The sound left my mouth whole and ordinary. I hated it for proving I could still make anything that did not belong to you."

[sub_resource type="Resource" id="LoopThree_bargaining"]
script = ExtResource("3_stage")
grief_stage = 2
maze_memories = Array[String](["If I could remember her voice exactly, maybe time had not stolen everything.", "I watched old videos until the pixels became prayer.", "I tried to imagine her at thirteen, then sixteen, then twenty, and hated every version for being fiction.", "I bought a birthday candle and did not light it.", "I asked memory to raise her when I could not."])
closing_memory = "I paused the video on the half-second before your laugh and tried to live there. Your mouth open, your eyes almost closed, the sound not yet gone. I kept pressing play and losing you again."

[sub_resource type="Resource" id="LoopThree_depression"]
script = ExtResource("3_stage")
grief_stage = 3
maze_memories = Array[String](["The second loss was quieter: not her body, but the edges of her.", "Her voice faded first, then the weight of her asleep against me.", "I had photographs of her face and no photograph of how she smelled after rain.", "I realized I was grieving the child and the older child and the woman she never became.", "Some days I missed a stranger who would have had her eyes."])
closing_memory = "On her birthday, I tried to picture the candles and could not decide how many belonged on the cake. Seven was true. Everything after was true in a different, crueler way."

[sub_resource type="Resource" id="LoopThree_acceptance"]
script = ExtResource("3_stage")
grief_stage = 4
maze_memories = Array[String](["I let her stay seven without making seven a cage.", "I stopped punishing myself for not remembering everything.", "I lit the candle and let it burn down.", "I loved the child I had and the ghost of every age I lost.", "I carried her forward, not as weight, but as weather."])
closing_memory = "I stopped the video before the laugh this time. Not because I could bear losing it. Because I already knew it had happened. I sat in the quiet after her face disappeared and let the quiet be part of her too."

[sub_resource type="Resource" id="LoopThree"]
script = ExtResource("2_loop")
title = "The Shape Time Leaves"
stages = Array[ExtResource("3_stage")]([SubResource("LoopThree_denial"), SubResource("LoopThree_anger"), SubResource("LoopThree_bargaining"), SubResource("LoopThree_depression"), SubResource("LoopThree_acceptance")])

[resource]
script = ExtResource("1_story")
title = "Borrowed Weather"
loops = Array[ExtResource("2_loop")]([SubResource("LoopOne"), SubResource("LoopTwo"), SubResource("LoopThree")])
reveal = "I thought I was losing her when the machines got louder than her voice. I thought if I watched closely enough, counted carefully enough, loved fiercely enough, I could keep some door from closing. But children do not become less children because they are dying. She still wanted apple juice. She still asked about playgrounds. She still thanked God for pudding while I sat beside her inventing bargains no heaven accepted.

Afterward, I thought the loss would be simple because it had already done the impossible. She was gone. What more could grief take? Then I learned it could take her toothbrush one morning, her blanket another, the way people looked at me when I said daughter. It made me pack drawers like I was betraying her one folded shirt at a time. I became the mother of a dead child, which is still a mother, though no one knows where to put you at the table.

Years later, I discovered grief had not ended. It had only changed rooms. I started losing the sound of her laugh. I lost the exact weight of her in my arms. I lost the girl she would have been, and the teenager, and the woman. I had to stop asking memory to raise her for me. She was seven. She is seven. She would have been everything. I light the candle now and let it go out, because loving her was never the same thing as keeping her."
